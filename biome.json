{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.jsx",
			"**/*.json",
			"**/*.css",
			"!node_modules",
			"!**/node_modules",
			"!dist",
			"!**/dist",
			"!build",
			"!**/build",
			"!.turbo",
			"!**/.turbo",
			"!*.lock",
			"!bun.lock",
			"!bun.lockb",
			"!package-lock.json",
			"!pnpm-lock.yaml",
			"!yarn.lock",
			"!**/_generated",
			"!packages/convex/_generated"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	}
}
